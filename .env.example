# ============================================================
# Catur Romantis - Konfigurasi Tencent Cloud
# Salin file ini menjadi ".env" lalu isi nilainya.
#
# Cara mendapatkan nilai:
# 1. Buka https://console.cloud.tencent.com/  (daftar/login)
# 2. Buat aplikasi di layanan "实时音视频 TRTC"
#    (atau "Chat / 即时通信 IM" -- keduanya memakai SDKAppID yang sama)
#    https://console.cloud.tencent.com/trtc/app/create
# 3. Setelah aplikasi dibuat, buka "应用管理" (Application Management):
#    - SDKAppID  -> salin ke bawah
#    - SecretKey / 密钥 -> salin ke bawah
#      (jika tombol "显示密钥" belum ada, aktifkan layanan IM/TRTC dulu)
#
# PENTING: Jangan pernah commit file .env ke reposori publik.
# ============================================================

# SDKAppID aplikasi Tencent Cloud Anda (angka)
SDKAPPID=0

# SecretKey aplikasi (string panjang)
SECRETKEY=

# Port server (opsional, default 3100 — dipilih agar tidak bentrok
# dengan Vite/Negina yang biasa memakai 3000)
PORT=3100

# Set 1 untuk menjalankan HTTPS dengan sertifikat self-signed.
# Diperlukan agar mikrofon (voice chat) bisa jalan di browser HP
# saat diakses lewat jaringan LAN / internet (bukan localhost).
USE_HTTPS=0
